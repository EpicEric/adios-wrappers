---
import { highlighter } from "../lib/highlight";

interface Props {
    code: string;
}

const { code } = Astro.props;

const highlightedCode = highlighter.highlight(code.replaceAll(",", ", "), {
    language: "korora",
}).value;
---

<code class="code" set:html={highlightedCode} />

<style>
    code {
        padding: 8px;
        border-radius: 100vmax;

        font-size: 0.8em;
    }
</style>
