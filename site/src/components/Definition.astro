---
import CodeBlock from "./CodeBlock.astro";
import { shouldFold } from "../lib/fold";

interface Props {
    key: string;
    code: string;
    language: string;
}

const { key, code, language } = Astro.props;

let folded = shouldFold(code);
---

<div class:list={folded ? ["folded"] : []}>
    <dt>{key}</dt>
    <dd><CodeBlock code={code} language={language} /></dd>
</div>

<style>
    dt {
        font-weight: 600;
        font-size: medium;
    }

    dd,
    dt,
    dd :global(pre) {
        margin: 0;
    }

    /* No label boxes */
    /* dd {
        margin: 0 0 0 20px;
    }
    dd {
        margin-top: 1rem;
    } */
    /* End label boxes */

    /* Label boxes */
    .folded {
        display: flex;
        gap: 4px;
    }

    dt {
        background-color: #fff;
        padding: 16px;
        padding-block: 12px;
        border-radius: 16px;

        display: flex;
        align-items: center;
    }

    @media (prefers-color-scheme: dark) {
        dt {
            background-color: #1c1c1c;
        }
    }

    .folded dd {
        flex-grow: 1;
    }

    :not(.folded) dt {
        border-end-start-radius: 4px;
        border-end-end-radius: 4px;
    }

    .folded dt {
        border-start-end-radius: 4px;
        border-end-end-radius: 4px;
    }

    :not(.folded) dd > :global(pre) {
        border-start-start-radius: 4px;
        border-start-end-radius: 4px;
        margin: unset;
        margin-top: 4px;
        margin-bottom: 1rem;
    }

    .folded dd > :global(pre) {
        border-start-start-radius: 4px;
        border-end-start-radius: 4px;
    }
    /* End label boxes */
</style>
