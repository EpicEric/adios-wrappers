---
import { getCollection } from "astro:content";
import Global from "../layouts/Global.astro";

let modules = await getCollection("modules");
---

<Global>
  <Fragment slot="head">
    <title>adios-wrappers</title>
  </Fragment>

  <h1>adios-wrappers</h1>
  <a href="https://github.com/llakala/adios-wrappers">GitHub repository</a>

  <h2>Modules</h2>

  <ul>
    {
      modules.map((mod) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}/modules/${mod.id}`}>{mod.id}</a>
        </li>
      ))
    }
  </ul>
</Global>

<style>
  h1 {
    margin-bottom: 0;
  }

  ul {
    column-count: 3;
    column-gap: 5px;
    padding: 0;
    list-style: none;
  }

  ul li {
    break-inside: avoid;
  }
</style>
