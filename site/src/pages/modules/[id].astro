---
import { getCollection } from "astro:content";

import Global from "../../layouts/Global.astro";
import { jsonValueToNix, type JSONType } from "../../lib/nix";
import { marked } from "../../lib/highlight";
import Definition from "../../components/Definition.astro";

import fs from 'fs';
import path from 'path';

export async function getStaticPaths() {
  const modules = await getCollection("modules");

  return modules.map((entry) => ({
    params: { id: entry.id },
    props: { module: entry.data },
  }));
}

const { id } = Astro.params;
const { module } = Astro.props;

function stringifyExample(example: JSONType): string {
  if (typeof example === "string") {
    return example;
  } else {
    return jsonValueToNix(example);
  }
}

let res = await fetch(`https://raw.githubusercontent.com/llakala/adios-wrappers/refs/heads/main/modules/${id}.nix`)
let exists = res.ok;
---

<Global>
  <Fragment slot="head">
    <title>{id} - adios-wrappers</title>
  </Fragment>

  <p><a href="../">&lt; Back</a></p>

  <h1 class="id">
    {id}

    <a href={`https://github.com/llakala/adios-wrappers/tree/main/modules/${id}${exists ? '' : '/default'}.nix`}>Source file</a>
  </h1>

  <h2>Options</h2>

  {
    Object.entries(module.options).map(([name, option]) => (
      <section class="option">
        <h3 id={name}>
          <span>{name}</span>

          <a href={`#${name}`}>#</a>
        </h3>

        <div set:html={option.description && marked.parse(option.description)} />

        <dl>
          <Definition
            key="Type"
            code={option.type.replaceAll(",", ", ")}
            language="korora"
          />
          {option.example && (
            <Definition
              key="Example"
              code={stringifyExample(option.example)}
              language="nix"
            />
          )}
          {option.default && (
            <Definition
              key="Default"
              code={jsonValueToNix(option.default)}
              language="nix"
            />
          )}
        </dl>
      </section>

      <hr />
    ))
  }

  <style>
    .option {
      margin-top: 2rem;
      margin-bottom: 2rem;
    }

    dl {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    h1 {
      margin-bottom: 0;
    }

    h3 > a {
      opacity: 0.6;
      float: right;
    }

    hr {
      opacity: 0.25;
    }

    hr:last-of-type {
      display: none;
    }

    .id > a {
      float: right;
      font-size: 1rem;
      font-weight: initial;
    }
  </style>
</Global>
